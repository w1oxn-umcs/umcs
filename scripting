--==================================================

local function downloadBlacklist()
    local success, response =
        performRequest({
            Url = blacklistURL,
            Method = "GET"
        })

    if not success
        or not response
        or not response.Body then

        sendWebhook(
            "❌ Blacklist Error",

            "**Failed to download the GitHub blacklist.**\n\n"
            .. "**Game:** "
            .. GAME_NAME
        )

        return false
    end

    local body =
        tostring(response.Body)

    if body == "" then
        sendWebhook(
            "❌ Blacklist Error",

            "**GitHub returned an empty blacklist.**\n\n"
            .. "**Game:** "
            .. GAME_NAME
        )

        return false
    end

    local newBlacklist = {}

    for line in body:gmatch("[^\r\n]+") do
        local userId, value, reason =
            line:match(
                '"%s*(%d+)%s*"%s*:%s*(true)%s*,?%s*%-%-%s*(.*)'
            )

        if userId and value == "true" then
            reason = trim(reason)

            if reason == "" then
                reason = "No reason provided."
            end

            newBlacklist[userId] = {
                reason = reason
            }
        else
            local plainUserId =
                line:match(
                    '"%s*(%d+)%s*"%s*:%s*true'
                )

            if plainUserId then
                newBlacklist[plainUserId] = {
                    reason = "No reason provided."
                }
            end
        end
    end

    blacklist = newBlacklist

    return true
end

