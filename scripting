-- SEND COMBINED ACTIVITY EVERY 15 SECONDS
--==================================================

local function sendActivityBatch()
    if #activityLogBuffer == 0 then
        return
    end

    local entries =
        activityLogBuffer

    activityLogBuffer = {}

    local chunks = {}
    local currentChunk = ""

    for _, line in ipairs(entries) do
        line = tostring(line)

        if #line > 3600 then
            line =
                string.sub(line, 1, 3590)
                .. "..."
        end

        if currentChunk == "" then
            currentChunk = line

        elseif #currentChunk + #line + 1 <= 3600 then
            currentChunk =
                currentChunk
                .. "\n"
                .. line

        else
            table.insert(
                chunks,
                currentChunk
            )

            currentChunk = line
        end
    end

    if currentChunk ~= "" then
        table.insert(
            chunks,
            currentChunk
        )
    end

    for index, chunk in ipairs(chunks) do
        sendWebhook(
            "💬 Activity Logs"
            .. (
                #chunks > 1
                and " (" .. index .. "/" .. #chunks .. ")"
                or ""
            ),

            "**Game:** "
            .. GAME_NAME
            .. "\n"

            .. "**Place ID:** `"
            .. tostring(game.PlaceId)
            .. "`\n"

            .. "**Job ID:** `"
            .. escapeMarkdown(game.JobId)
            .. "`\n\n"

            .. chunk
        )

        if index < #chunks then
            task.wait(0.5)
        end
    end
end

task.spawn(function()
    while true do
        task.wait(ACTIVITY_LOG_INTERVAL)
        sendActivityBatch()
    end
end)

