local function getBotNumber()

    local localPlayer = Players.LocalPlayer

    if not localPlayer then
        return "000"
    end

    local number =
        localPlayer.Name:match("^PetrovistVictory(%d%d%d)$")

    if number then
        return number
    end

    return "000"
end

local BOT_NUMBER = getBotNumber()

--==================================================
-- WEBHOOK TIME
--==================================================

local function getWebhookTime()
    return os.date("%H:%M | %d/%m/%Y")
end

--==================================================
-- STRING HELPERS
--==================================================

local function trim(str)
    return tostring(str):match("^%s*(.-)%s*$")
end

local function normalize(str)
    return string.lower(trim(str))
end

local function escapeMarkdown(str)

    str = tostring(str)

    str = str:gsub("\\", "\\\\")
    str = str:gsub("%*", "\\*")
    str = str:gsub("`", "\\`")
    str = str:gsub("~", "\\~")

    return str
end

