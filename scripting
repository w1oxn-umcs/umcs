--==================================================

local function getDifferentServer()
    local currentJobId =
        tostring(game.JobId)

    local placeId =
        tostring(TARGET_PLACE_ID)

    local servers = {}
    local cursor = nil

    for page = 1, 10 do
        local url =
            "https://games.roblox.com/v1/games/"
            .. placeId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor then
            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(cursor)
        end

        local success, response =
            pcall(function()
                return httpRequest({
                    Url = url,
                    Method = "GET"
                })
            end)

        if not success
            or not response
            or not response.Body then

            break
        end

        local decodeSuccess, data =
            pcall(function()
                return HttpService:JSONDecode(
                    response.Body
                )
            end)

        if not decodeSuccess
            or type(data) ~= "table"
            or type(data.data) ~= "table" then

            break
        end

        for _, server in ipairs(data.data) do
            if type(server) == "table" then
                local serverId =
                    tostring(server.id or "")

                local playing =
                    tonumber(server.playing)
                    or 0

                local maxPlayers =
                    tonumber(server.maxPlayers)
                    or 0

                if serverId ~= ""
                    and serverId ~= currentJobId
                    and playing < maxPlayers then

                    table.insert(
                        servers,
                        serverId
                    )
                end
            end
        end

        if #servers > 0 then
            break
        end

        cursor =
            data.nextPageCursor

        if not cursor
            or cursor == "" then

            break
        end

        task.wait(0.2)
    end

    if #servers == 0 then
        return nil
    end

    return servers[
        math.random(
            1,
            #servers
        )
    ]
end

--==================================================
-- BOT SEPARATION
--==================================================

local function separateBots()
    if botSeparationTriggered then
        return
    end

    local bots =
        getBotsInServer()

    if #bots < MIN_BOTS then
        return
    end

    local stayingBot =
        getLowestBot(bots)

    if not stayingBot then
        return
    end

    if stayingBot == localPlayer then
        botSeparationTriggered = true
        return
    end

    botSeparationTriggered = true

    local botList = {}

    for _, bot in ipairs(bots) do
        table.insert(
            botList,

            "`"
            .. escapeMarkdown(bot.Name)
            .. "`"
        )
    end

    sendWebhook(
        "🔀 Bot Server Separation",

        "**Bots detected:** `"
        .. tostring(#bots)
        .. "`\n\n"

        .. table.concat(
            botList,
            "\n"
        )

        .. "\n\n"

        .. "**Staying Bot:** `"
        .. escapeMarkdown(stayingBot.Name)
        .. "`\n"

        .. "**Leaving Bot:** `"
        .. escapeMarkdown(localPlayer.Name)
        .. "`\n"

        .. "**Destination Place ID:** `"
        .. tostring(TARGET_PLACE_ID)
        .. "`\n"

        .. "**Current Job ID:** `"
        .. escapeMarkdown(game.JobId)
        .. "`\n\n"

        .. "**Game:** "
        .. GAME_NAME
    )

    task.wait(1)

    queueMonitorAfterTeleport()

    local targetJobId = nil

    for attempt = 1, 10 do
        targetJobId =
            getDifferentServer()

        if targetJobId
            and targetJobId ~= tostring(game.JobId) then

            break
        end

        targetJobId = nil

        task.wait(1)
    end

    if not targetJobId then
        botSeparationTriggered = false
        return
    end

    if targetJobId == tostring(game.JobId) then
        botSeparationTriggered = false
        return
    end

    pcall(function()
        TeleportService:TeleportToPlaceInstance(
            TARGET_PLACE_ID,
            targetJobId,
            localPlayer
        )
    end)
end

