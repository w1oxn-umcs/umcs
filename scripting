local function sendWebhook(title, description, joinServer)

    if not WEBHOOK_URL
        or WEBHOOK_URL == "" then

        return
    end

    local embed = {
        title = title,

        description =
            description
            .. "\n\n"
            .. "**"
            .. BOT_NUMBER
            .. " | "
            .. getWebhookTime()
            .. "**"
    }

    local payload = {
        username = "Roblox Server Monitor",

        embeds = {
            embed
        }
    }

    if joinServer then

        local joinURL =
            "https://www.roblox.com/games/start?placeId="
            .. tostring(game.PlaceId)
            .. "&gameInstanceId="
            .. tostring(game.JobId)

        payload.components = {
            {
                type = 1,

                components = {
                    {
                        type = 2,
                        style = 5,

                        label = "Join Server",

                        emoji = {
                            name = "🔗"
                        },

                        url = joinURL
                    }
                }
            }
        }
    end

    pcall(function()

        request({
            Url = WEBHOOK_URL,

            Method = "POST",

            Headers = {
                ["Content-Type"] = "application/json"
            },

            Body = HttpService:JSONEncode(payload)
        })

    end)
end

