local function attachToxifyHealth(char)
    if not char then
        return
    end

    local hum =
        char:FindFirstChildOfClass(
            "Humanoid"
        )

    if not hum then
        return
    end

    pcall(function()
        hum.MaxHealth = math.huge
        hum.Health = math.huge
    end)

    hum.HealthChanged:Connect(function(hp)
        if resetting then
            return
        end

        if hp < math.huge then
            task.defer(function()
                pcall(function()
                    hum.MaxHealth = math.huge
                    hum.Health = math.huge
                end)
            end)
        end
    end)
end

