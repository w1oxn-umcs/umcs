local plr = localPlayer
local playerGui = plr:WaitForChild("PlayerGui")

local antiVoidEnabled = true
local antiGravityEnabled = true

local originalDestroyHeight =
    workspace.FallenPartsDestroyHeight

local originalGravity =
    workspace.Gravity

local stashRunning = false
local flingInProgress = false

local resetting = false

local antiConnections = {}

local function setAntiConnection(name, connection)
    if antiConnections[name] then
        pcall(function()
            antiConnections[name]:Disconnect()
        end)
    end

    antiConnections[name] = connection
end

local function disconnectAnti(name)
    if antiConnections[name] then
        pcall(function()
            antiConnections[name]:Disconnect()
        end)

        antiConnections[name] = nil
    end
end

local function getCharacterPart(partName)
    local character = plr.Character

    if not character then
        return nil
    end

    if partName == "hrp" then
        partName = "HumanoidRootPart"
    elseif partName == "hum" then
        partName = "Humanoid"
    end

    return character:FindFirstChild(partName)
end

local function breakvel()
    local zero =
        Vector3.new(0, 0, 0)

    local endTime =
        tick() + 1

    while tick() < endTime do
        if plr.Character then
            for _, part in ipairs(
                plr.Character:GetChildren()
            ) do
                if part:IsA("BasePart") then
                    part.Velocity = zero
                    part.RotVelocity = zero
                    part.AssemblyLinearVelocity = zero
                    part.AssemblyAngularVelocity = zero
                end
            end
        end

        task.wait()
    end
end

local function askreset()
    local hum =
        getCharacterPart("hum")

    if hum and hum.Health > 0 then
        resetting = true
        hum.Health = 0

        task.delay(4, function()
            resetting = false
        end)
    end
end

local function askunstun()
    local hum =
        getCharacterPart("hum")

    if hum then
        hum.PlatformStand = false
        hum.Sit = false
        hum:ChangeState(
            Enum.HumanoidStateType.GettingUp
        )
    end
end

local function removeForcedMovers(character)
    if not character then
        return
    end

    for _, mover in ipairs(
        character:GetDescendants()
    ) do
        if not mover:FindFirstAncestorOfClass("Tool")
            and (
                mover:IsA("BodyVelocity")
                or mover:IsA("BodyAngularVelocity")
                or mover:IsA("BodyPosition")
                or mover:IsA("BodyGyro")
                or mover:IsA("LinearVelocity")
                or mover:IsA("AngularVelocity")
                or mover:IsA("VectorForce")
                or mover:IsA("AlignPosition")
                or mover:IsA("AlignOrientation")
            )
        then
            pcall(function()
                mover:Destroy()
            end)
        end
    end
end

