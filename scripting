local function getSpyChatInfo(mdata)
    local plr =
        mdata.TextSource
        and mdata.TextSource.UserId
        and Players:GetPlayerByUserId(
            mdata.TextSource.UserId
        )

    if not plr then
        return nil
    end

    local originalText = mdata.Text

    local hidden = false
    local muted = plr:HasTag("Muted")
    local cn = ""

    if plr.Neutral == true then
        if plr:GetAttribute("Arken") == true then
            cn = "arken"
        else
            cn = "peasant"
        end
    else
        cn = "admin"
    end

    if muted then
        cn = "hidden"
    end

    if string.sub(originalText, 1, 1) == ";" then
        if on and spychat then
            cn = "hidden"
            hidden = true
        end
    end

    local iq = nil

    if on and spychat and plr:GetAttribute("IQ") then
        if plr:GetAttribute("IQ") >= 200 then
            iq = "genius 🧠"
            cn = "iqgenius"

        elseif plr:GetAttribute("IQ") <= 50 then
            iq = "dumb 🤪"
            cn = "iqdumb"
        end
    end

    return {
        player = plr,
        originalText = originalText,
        hidden = hidden,
        muted = muted,
        iq = iq,
        category = cn
    }
end

local function oimremake(mdata)
    local info = getSpyChatInfo(mdata)

    if not info then
        return
    end

    local plr = info.player
    local hidden = info.hidden
    local muted = info.muted
    local iq = info.iq
    local cn = info.category

    if muted then
        if not on or not spychat then
            mdata.Text = ""
        end
    end

    if string.sub(mdata.Text, 1, 1) == ";" then
        if on and spychat then
            cn = "hidden"
            hidden = true
        else
            mdata.Text = ""
        end
    end

    if isog then
        mdata.PrefixText =
            "<font color=\""
            .. namecolorshex[cn]
            .. "\"><b><font color='rgb("
            .. tostring(namecolors[cn][1])
            .. ","
            .. tostring(namecolors[cn][2])
            .. ","
            .. tostring(namecolors[cn][3])
            .. ")'>["
            .. plr.DisplayName
            .. ((hidden and " (HIDDEN CHAT)") or "")
            .. ((iq and (" (" .. iq .. ")")) or "")
            .. ((muted and " (MUTED)") or "")
            .. "]: </font></b></font>"
    else
        mdata.PrefixText =
            "<font color=\""
            .. namecolorshex[cn]
            .. "\"><i><font color='rgb("
            .. tostring(namecolors[cn][1])
            .. ","
            .. tostring(namecolors[cn][2])
            .. ","
            .. tostring(namecolors[cn][3])
            .. ")'>("
            .. plr.DisplayName
            .. ((hidden and " (HIDDEN CHAT)") or "")
            .. ((iq and (" (" .. iq .. ")")) or "")
            .. ((muted and " (MUTED)") or "")
            .. ") </font></i></font>"
    end
