--// STRING HELPERS

local function escapeMarkdown(text)
    text = tostring(text or "")

    text = text:gsub("\\", "\\\\")
    text = text:gsub("%*", "\\*")
    text = text:gsub("_", "\\_")
    text = text:gsub("`", "\\`")

    return text
end


local function trim(text)
    return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end


--// WEBHOOK

local function sendWebhook(title, description, icon, joinServer)
    local footer =
        "\n\n**"
        .. BOT_NUMBER
        .. " | "
        .. getWebhookTime()
        .. "**"

    description = description .. footer

    local payload = {
        embeds = {
            {
                title = icon .. " " .. title,
                description = description,
                color = 5763719
            }
        }
    }

    if joinServer then
        payload.embeds[1].components = {
            {
                type = 1,
                components = {
                    {
                        type = 2,
                        style = 5,
                        label = "Join Server",
                        url =
                            "https://www.roblox.com/games/start?placeId="
                            .. tostring(game.PlaceId)
                            .. "&gameInstanceId="
                            .. tostring(game.JobId)
                    }
                }
            }
        }
    end

    local body = HttpService:JSONEncode(payload)

    pcall(function()
        local req = request({
            Url = WEBHOOK_URL,
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = body
        })

        if req and req.Body then
            return
        end
    end)
end


