local freezeTimer = 0
local lastGoodCF = nil

setAntiConnection(
    "Freeze",

    RunService.Heartbeat:Connect(function(dt)
        freezeTimer =
            freezeTimer + dt

        if freezeTimer < 0.5 then
            return
        end

        freezeTimer = 0

        if stashRunning then
            return
        end

        if not plr.Character then
            return
        end

        local hrp =
            plr.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        local hum =
            plr.Character:FindFirstChildOfClass(
                "Humanoid"
            )

        if hrp
            and hum
            and hum.Health > 0
            and not hrp.Anchored then

            lastGoodCF = hrp.CFrame
        end

        local frozen = false

        local characterModel =
            workspace:FindFirstChild(
                plr.Name
            )

        if characterModel
            and characterModel:FindFirstChild("Hielo") then

            if hum then
                resetting = true

                hum:ChangeState(
                    Enum.HumanoidStateType.Dead
                )
            end

            frozen = true
        end

        if hrp
            and hum
            and hrp.Anchored == true then

            resetting = true
            hum.Health = 0
            frozen = true
        end

        local torso =
            plr.Character:FindFirstChild("Torso")

        if torso
            and hum
            and torso.Transparency == 1 then

            resetting = true
            hum.Health = 0
            frozen = true
        end

        if frozen and lastGoodCF then
            local savedCF = lastGoodCF

            plr.CharacterAdded:Once(function(newChar)
                task.wait(0.5)

                local newHrp =
                    newChar:WaitForChild(
                        "HumanoidRootPart",
                        5
                    )

                if newHrp then
                    newHrp.CFrame = savedCF
                end

                resetting = false
            end)
        end
    end)
)

