local function downloadBlacklist()

    local success, response =
        pcall(function()

            return request({
                Url = blacklistURL,
                Method = "GET"
            })

        end)

    if not success
        or not response then

        sendWebhook(
            "❌ Blacklist Error",

            "**Failed to download the GitHub blacklist.**\n\n"
            .. "**Game:** "
            .. GAME_LINK
        )

        return false
    end

    local body =
        response.Body

    if not body
        or body == "" then

        sendWebhook(
            "❌ Blacklist Error",

            "**GitHub returned an empty blacklist.**\n\n"
            .. "**Game:** "
            .. GAME_LINK
        )

        return false
    end

    local newBlacklist = {}

    for line in body:gmatch(
        "[^\r\n]+"
    ) do

        local userId, value, reason =
            line:match(
                '"%s*(%d+)%s*"%s*:%s*(true)%s*,?%s*%-%-%s*(.*)'
            )

        if userId
            and value == "true" then

            reason =
                trim(reason)

            if reason == "" then
                reason =
                    "No reason provided."
            end

            newBlacklist[userId] = {
                reason = reason
            }

        else

            local plainUserId =
                line:match(
                    '"%s*(%d+)%s*"%s*:%s*true'
                )

            if plainUserId then

                newBlacklist[
                    plainUserId
                ] = {
                    reason =
                        "No reason provided."
                }

            end

        end

    end

    blacklist =
        newBlacklist

    return true
end

