local function escapeMarkdown(str)

    str = tostring(str)

    str = str:gsub("\\", "\\\\")
    str = str:gsub("%*", "\\*")
    str = str:gsub("`", "\\`")
    str = str:gsub("~", "\\~")

    return str
end

