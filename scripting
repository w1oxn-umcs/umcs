local function separateBots()

    if botSeparationTriggered then
        return
    end

    local bots =
        getBotsInServer()

    if #bots < MIN_BOTS then
        return
    end

    botSeparationTriggered = true

    local botList = {}

    for _, bot in ipairs(
        bots
    ) do

        table.insert(
            botList,

            "`"
            .. escapeMarkdown(
                bot.Name
            )
            .. "`"

        )

    end

    sendWebhook(
        "🔀 Bot Server Separation",

        "**Bots detected:** `"
        .. tostring(
            #bots
        )
        .. "`\n\n"

        .. table.concat(
            botList,
            "\n"
        )

        .. "\n\n"

        .. "**Destination Place ID:** `"
        .. tostring(
            TARGET_PLACE_ID
        )
        .. "`\n"

        .. "**Current Job ID:** `"
        .. escapeMarkdown(
            game.JobId
        )
        .. "`\n\n"

        .. "**Game:** "
        .. GAME_LINK
    )

    task.wait(1)

    pcall(function()

        TeleportService:Teleport(
            TARGET_PLACE_ID,
            localPlayer
        )

    end)

end

