--==================================================
-- FIND DIFFERENT PUBLIC SERVER
--==================================================

local function findDifferentServer()

    local currentJobId = game.JobId
    local placeId = TARGET_PLACE_ID

    local candidates = {}

    local cursor = nil
    local pagesChecked = 0

    while pagesChecked < 3 do

        local url =
            "https://games.roblox.com/v1/games/"
            .. tostring(placeId)
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor then
            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(cursor)
        end

        local success, response = pcall(function()

            return request({
                Url = url,
                Method = "GET"
            })

        end)

        if not success or not response then
            break
        end

        local decodeSuccess, body =
            pcall(function()

                return HttpService:JSONDecode(
                    response.Body
                )

            end)

        if not decodeSuccess or type(body) ~= "table" then
            break
        end

        if type(body.data) ~= "table" then
            break
        end

        for _, server in ipairs(body.data) do

            if type(server) == "table" then

                local serverId =
                    tostring(server.id or "")

                local playing =
                    tonumber(server.playing)

                local maxPlayers =
                    tonumber(server.maxPlayers)

                if serverId ~= ""
                    and serverId ~= currentJobId
                    and playing
                    and maxPlayers
                    and playing < maxPlayers then

                    table.insert(
                        candidates,
                        serverId
                    )

                end
            end
        end

        local nextCursor =
            body.nextPageCursor

        if not nextCursor
            or nextCursor == ""
            or nextCursor == "null" then

            break
        end

        cursor = nextCursor
        pagesChecked += 1
    end

    if #candidates == 0 then
        return nil
    end

    return candidates[
        math.random(
            1,
            #candidates
        )
    ]
end

--==================================================
-- BOT SERVER HOP
--==================================================

local function hopToDifferentServer()

    local targetServerId =
        findDifferentServer()

    if not targetServerId then

        sendWebhook(
            "❌ Bot Server Separation Failed",

            "**Could not find another available public server.**\n\n"

            .. "**Current Job ID:** `"
            .. escapeMarkdown(game.JobId)
            .. "`\n"

            .. "**Place ID:** `"
            .. tostring(TARGET_PLACE_ID)
            .. "`"
        )

        return false
    end

    sendWebhook(
        "🔀 Bot Server Separation",

        "**Current Job ID:** `"
        .. escapeMarkdown(game.JobId)
        .. "`\n\n"

        .. "**Destination Place ID:** `"
        .. tostring(TARGET_PLACE_ID)
        .. "`\n"

        .. "**Destination Job ID:** `"
        .. escapeMarkdown(targetServerId)
        .. "`"
    )

    -- Queue the monitor before teleporting.
    queueMonitorReexecution()

    task.wait(1)

    local localPlayer =
        Players.LocalPlayer

    if not localPlayer then
        return false
    end

    local success, errorMessage =
        pcall(function()

            TeleportService:TeleportToPlaceInstance(
                TARGET_PLACE_ID,
                targetServerId,
                localPlayer
            )

        end)

    if not success then

        sendWebhook(
            "❌ Bot Server Separation Failed",

            "**Teleport failed:** `"
            .. escapeMarkdown(errorMessage)
            .. "`\n\n"

            .. "**Destination Job ID:** `"
            .. escapeMarkdown(targetServerId)
            .. "`"
        )

        return false
    end

    return true
end

--==================================================
-- BOT SEPARATION
--==================================================

local function separateBots()

    if botSeparationTriggered then
        return
    end

    local bots =
        getBotsInServer()

    if #bots < MIN_BOTS then
        return
    end

    botSeparationTriggered = true

    local botList = {}

    for _, bot in ipairs(bots) do

        table.insert(
            botList,

            "`"
            .. escapeMarkdown(bot.Name)
            .. "`"
        )

    end

    -- Find and enter a different server.
    hopToDifferentServer()
end

