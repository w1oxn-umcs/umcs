--==================================================

local flingSpeedCap = 200
local maxStuds = 10000

setAntiConnection(
    "Fling",

    RunService.Heartbeat:Connect(function()
        if not plr.Character then
            return
        end

        local root =
            plr.Character:FindFirstChild(
                "HumanoidRootPart"
            )

        if not root then
            return
        end

        if flingInProgress then
            return
        end

        local velocity =
            root.AssemblyLinearVelocity

        local speed =
            velocity.Magnitude

        local pos =
            root.Position

        if speed > flingSpeedCap then
            root.AssemblyLinearVelocity =
                Vector3.new(0, 0, 0)

            root.AssemblyAngularVelocity =
                Vector3.new(0, 0, 0)
        end

        if math.abs(pos.X) > maxStuds
            or math.abs(pos.Y) > maxStuds
            or math.abs(pos.Z) > maxStuds then

            root.AssemblyLinearVelocity =
                Vector3.new(0, 0, 0)

            plr.Character:PivotTo(
                CFrame.new(0, 200, 0)
            )

            breakvel()
        end
    end)
)

