        .. "`\n\n"

        .. "**Game:** "
        .. GAME_NAME
    )

    task.wait(1)

    -- Queue the complete monitor before teleport.
    queueMonitorAfterTeleport()

    local targetJobId = nil

    for attempt = 1, 10 do
        targetJobId =
            getDifferentServer()

        if targetJobId
            and targetJobId ~= tostring(game.JobId) then

            break
        end

        targetJobId = nil

        task.wait(1)
    end

    if not targetJobId then
        botSeparationTriggered = false
        return
    end

    if targetJobId == tostring(game.JobId) then
        botSeparationTriggered = false
        return
    end

    -- Flush any pending activity before leaving.
    sendActivityBatch()

    local teleportSuccess =
        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                TARGET_PLACE_ID,
                targetJobId,
                localPlayer
            )
        end)

    if not teleportSuccess then
        botSeparationTriggered = false
    end
end

--==================================================
-- PLAYER JOINED
--==================================================

local function playerJoined(player)
    if not player then
        return
    end

    if isBlacklisted(player) then
        alertBlacklisted(player)
    end

    if LOG_PLAYER_JOINS
        and not joinedLogged[player.UserId] then

        joinedLogged[player.UserId] = true

        addActivityLog(
            "👤 **JOINED** `"
            .. escapeMarkdown(player.Name)
            .. "` (`"
            .. escapeMarkdown(player.DisplayName)
            .. "`)"
        )
    end

    task.wait(1)

    separateBots()
end

--==================================================
-- PLAYER LEFT
--==================================================

local function playerLeft(player)
    if not player then
        return
    end

    local userId =
        tostring(player.UserId)

    blacklistAlertedThisSession[userId] = nil
    joinedLogged[player.UserId] = nil

    if LOG_PLAYER_LEAVES
        and not leftLogged[player.UserId] then

        leftLogged[player.UserId] = true

        addActivityLog(
            "🚪 **LEFT** `"
            .. escapeMarkdown(player.Name)
            .. "` (`"
            .. escapeMarkdown(player.DisplayName)
            .. "`)"
        )
    end
end

