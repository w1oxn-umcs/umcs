--// BLACKLIST

local blacklist = {}
local blacklistReasons = {}
local lastBlacklistAlert = {}


local function loadBlacklist()
    local success, result = pcall(function()
        return game:HttpGet(blacklistURL)
    end)

    if not success or not result then
        return false
    end

    local newBlacklist = {}
    local newReasons = {}

    for line in result:gmatch("[^\r\n]+") do
        local userId, value, comment =
            line:match('"(%d+)"%s*:%s*(true|false)%s*,?%s*%-%-%s*(.*)')

        if not userId then
            userId, value =
                line:match('"(%d+)"%s*:%s*(true|false)')
        end

        if userId and value == "true" then
            newBlacklist[userId] = true

            if comment then
                newReasons[userId] = trim(comment)
            end
        end
    end

    blacklist = newBlacklist
    blacklistReasons = newReasons

    return true
end


local function checkBlacklist(player)
    if not player then
        return
    end

    local userId = tostring(player.UserId)

    if not blacklist[userId] then
        return
    end

    local now = os.time()

    if lastBlacklistAlert[userId]
        and now - lastBlacklistAlert[userId] < BLACKLIST_ALERT_COOLDOWN then
        return
    end

    lastBlacklistAlert[userId] = now

    local reason =
        blacklistReasons[userId]
        or "No reason provided."

    sendRobloxChat("test")

    local description =
        "**Player:** `"
        .. escapeMarkdown(player.Name)
        .. "`\n"
        .. "**Display Name:** `"
        .. escapeMarkdown(player.DisplayName)
        .. "`\n"
        .. "**User ID:** `"
        .. userId
        .. "`\n"
        .. "**Reason:** "
        .. escapeMarkdown(reason)
        .. "\n"
        .. "**Game:** "
        .. GAME_NAME
        .. "\n"
        .. "**Place ID:** `"
        .. tostring(game.PlaceId)
        .. "`\n"
        .. "**Job ID:** `"
        .. tostring(game.JobId)
        .. "`"

    sendWebhook(
        "Blacklisted Player Detected",
        description,
        "🚨",
        true
    )
end


--// BOT DETECTION

local function getCurrentBots()
    local bots = {}

    for _, player in ipairs(Players:GetPlayers()) do
        for _, botName in ipairs(BOT_NAMES) do
            if string.lower(player.Name) == string.lower(botName) then
                table.insert(bots, player)
                break
            end
        end
    end

    return bots
end


local function getLowestBot(bots)
    local lowestPlayer = nil
    local lowestNumber = math.huge

    for _, player in ipairs(bots) do
        local number = getBotNumber(player.Name)

        if number < lowestNumber then
            lowestNumber = number
            lowestPlayer = player
        end
    end

    return lowestPlayer
end


