--// LEGACY CHAT FALLBACK

local legacyConnections = {}

local function hookLegacyPlayer(player)
    if legacyConnections[player] then
        return
    end

    local connection = player.Chatted:Connect(function(message)
        if not LOG_CHAT then
            return
        end

        addActivity(
            "["
            .. os.date("%H:%M:%S")
            .. "] "
            .. "**"
            .. escapeMarkdown(player.Name)
            .. "** (`"
            .. escapeMarkdown(player.DisplayName)
            .. "`): "
            .. escapeMarkdown(message)
        )
    end)

    legacyConnections[player] = connection
end


for _, player in ipairs(Players:GetPlayers()) do
    hookLegacyPlayer(player)
end


