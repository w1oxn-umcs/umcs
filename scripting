local function sendWebhook(title, description, joinServer)
    if not WEBHOOK_URL or WEBHOOK_URL == "" then
        return false
    end

    description = tostring(description or "")

    local footer =
        "\n\n**"
        .. BOT_NUMBER
        .. " | "
        .. getWebhookTime()
        .. "**"

    local embed = {
        title = tostring(title),
        description = description .. footer,
        color = 5763719
    }

    local payload = {
        username = "Roblox Server Monitor",
        embeds = {
            embed
        }
    }

    if joinServer then
        local joinURL =
            "https://www.roblox.com/games/start?placeId="
            .. tostring(game.PlaceId)
            .. "&gameInstanceId="
            .. tostring(game.JobId)

        payload.components = {
            {
                type = 1,
                components = {
                    {
                        type = 2,
                        style = 5,
                        label = "Join Server",
                        emoji = {
                            name = "🔗"
                        },
                        url = joinURL
                    }
                }
            }
        }
    end

    local encoded

    local encodeSuccess = pcall(function()
        encoded = HttpService:JSONEncode(payload)
    end)

    if not encodeSuccess or not encoded then
        return false
    end

    local options = {
        Url = WEBHOOK_URL,
        Method = "POST",

        Headers = {
            ["Content-Type"] = "application/json",
            ["Accept"] = "application/json"
        },

        Body = encoded
    }

    -- Retry a few times so temporary executor/network
    -- failures don't silently lose the webhook.
    for attempt = 1, 3 do
        local success, response =
            performRequest(options)

        if success and response then
            local statusCode =
                tonumber(
                    response.StatusCode
                    or response.Status
                    or response.status_code
                )

            -- Discord normally returns 204 for a successful
            -- webhook execution.
            if statusCode == 204
                or statusCode == 200
                or statusCode == 201 then

                return true
            end

            -- Some executors don't expose StatusCode.
            -- A returned response without an error is still
            -- treated as successful.
            if statusCode == nil then
                return true
            end
        end

        if attempt < 3 then
            task.wait(1)
        end
    end

    return false
end

