local randomGenerator =
    Random.new()

local function getDifferentServer()
    local currentJobId =
        tostring(game.JobId)

    local placeId =
        tostring(TARGET_PLACE_ID)

    local servers = {}
    local cursor = nil

    for page = 1, 10 do
        local url =
            "https://games.roblox.com/v1/games/"
            .. placeId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor then
            url =
                url
                .. "&cursor="
                .. HttpService:UrlEncode(cursor)
        end

        local success, response =
            performRequest({
                Url = url,
                Method = "GET"
            })

        if not success
            or not response
            or not response.Body then

            break
        end

        local decodeSuccess, data =
            pcall(function()
                return HttpService:JSONDecode(
                    response.Body
                )
            end)

        if not decodeSuccess
            or type(data) ~= "table"
            or type(data.data) ~= "table" then

            break
        end

        for _, server in ipairs(data.data) do
            if type(server) == "table" then
                local serverId =
                    tostring(server.id or "")

                local playing =
                    tonumber(server.playing)
                    or 0

                local maxPlayers =
                    tonumber(server.maxPlayers)
                    or 0

                if serverId ~= ""
                    and serverId ~= currentJobId
                    and playing < maxPlayers then

                    table.insert(
                        servers,
                        serverId
                    )
                end
            end
        end

        if #servers > 0 then
            break
        end

        cursor =
            data.nextPageCursor

        if not cursor
            or cursor == "" then

            break
        end

        task.wait(0.2)
    end

    if #servers == 0 then
        return nil
    end

    return servers[
        randomGenerator:NextInteger(
            1,
            #servers
        )
    ]
end

