local function alertBlacklisted(player)
    local userId =
        tostring(player.UserId)

    if blacklistAlertedThisSession[userId] then
        return
    end

    local now =
        os.clock()

    local lastAlert =
        blacklistAlertCooldown[userId]

    if lastAlert
        and (now - lastAlert)
            < BLACKLIST_ALERT_COOLDOWN then

        return
    end

    local blacklisted, reason =
        isBlacklisted(player)

    if not blacklisted then
        return
    end

    blacklistAlertedThisSession[userId] =
        true

    blacklistAlertCooldown[userId] =
        now

    local username =
        escapeMarkdown(player.Name)

    local displayName =
        escapeMarkdown(player.DisplayName)

    sendChatMessage("test")

    sendWebhook(
        "test",

        "**Player:** `"
        .. username
        .. "`\n"

        .. "**Display Name:** `"
        .. displayName
        .. "`\n"

        .. "**User ID:** `"
        .. userId
        .. "`\n\n"

        .. "**Reason:**\n"
