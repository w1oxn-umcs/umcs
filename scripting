--// FIND A DIFFERENT PUBLIC SERVER

local function getDifferentServer()
    local currentJobId = tostring(game.JobId)
    local currentPlaceId = tostring(game.PlaceId)

    local servers = {}

    local cursor = nil
    local pagesChecked = 0
    local maxPages = 5

    while pagesChecked < maxPages do
        pagesChecked += 1

        local url =
            "https://games.roblox.com/v1/games/"
            .. currentPlaceId
            .. "/servers/Public?sortOrder=Asc&limit=100"

        if cursor then
            url = url
                .. "&cursor="
                .. HttpService:UrlEncode(cursor)
        end

        local success, response = pcall(function()
            return game:HttpGet(url)
        end)

        if not success or not response then
            break
        end

        local decodeSuccess, body = pcall(function()
            return HttpService:JSONDecode(response)
        end)

        if not decodeSuccess or not body or not body.data then
            break
        end

        for _, server in ipairs(body.data) do
            if type(server) == "table" then
                local serverId = tostring(server.id or "")
                local playing = tonumber(server.playing) or 0
                local maxPlayers = tonumber(server.maxPlayers) or 0

                if serverId ~= ""
                    and serverId ~= currentJobId
                    and playing < maxPlayers then

                    table.insert(servers, serverId)
                end
            end
        end

        if #servers > 0 then
            break
        end

        cursor = body.nextPageCursor

        if not cursor
            or cursor == ""
            or cursor == "null" then
            break
        end
    end

    if #servers == 0 then
        return nil
    end

    return servers[math.random(1, #servers)]
end


--// SERVER SEPARATION

local botSeparationTriggered = false


local function separateBots()
    if botSeparationTriggered then
        return
    end

    local bots = getCurrentBots()

    if #bots < MIN_BOTS then
        return
    end

    local stayingBot = getLowestBot(bots)

    if not stayingBot then
        return
    end

    if stayingBot ~= localPlayer then
        botSeparationTriggered = true

        local leavingBot = localPlayer

        local description =
            "**Bots detected:** `"
            .. tostring(#bots)
            .. "`\n"

        for _, bot in ipairs(bots) do
            description =
                description
                .. "`"
                .. bot.Name
                .. "` "
        end

        description =
            description
            .. "\n\n"
            .. "**Staying Bot:** `"
            .. stayingBot.Name
            .. "`\n"
            .. "**Leaving Bot:** `"
            .. leavingBot.Name
            .. "`\n"
            .. "**Current Job ID:** `"
            .. tostring(game.JobId)
            .. "`\n"
            .. "**Game:** "
            .. GAME_NAME

        sendWebhook(
            "Bot Server Separation",
            description,
            "🔀",
            false
        )

        task.wait(1)

        -- Make sure the script starts again after the teleport.
        queueMonitorAfterTeleport()

        local targetJobId = nil

        for attempt = 1, 5 do
            targetJobId = getDifferentServer()

            if targetJobId
                and targetJobId ~= tostring(game.JobId) then
                break
            end

            targetJobId = nil
            task.wait(1)
        end

        if not targetJobId then
            botSeparationTriggered = false
            return
        end

        -- Final safety check: NEVER teleport to the current JobId.
        if targetJobId == tostring(game.JobId) then
            botSeparationTriggered = false
            return
        end

        pcall(function()
            TeleportService:TeleportToPlaceInstance(
                TARGET_PLACE_ID,
                targetJobId,
                localPlayer
            )
        end)

        return
    end

    -- Lowest-numbered bot stays in the original server.
    botSeparationTriggered = true
end


