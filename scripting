--==================================================
-- DOWNLOAD BLACKLIST
--==================================================

local function downloadBlacklist()

    local success, response = pcall(function()

        return request({
            Url = blacklistURL,
            Method = "GET"
        })

    end)

    if not success or not response then

        sendWebhook(
            "❌ Blacklist Error",
            "**Failed to download the GitHub blacklist.**"
        )

        return false
    end

    local body = response.Body

    if not body or body == "" then

        sendWebhook(
            "❌ Blacklist Error",
            "**GitHub returned an empty blacklist.**"
        )

        return false
    end

    local newBlacklist = {}

    for line in body:gmatch("[^\r\n]+") do

        local userId, value, reason =
            line:match(
                '"%s*(%d+)%s*"%s*:%s*(true)%s*,?%s*%-%-%s*(.*)'
            )

        if userId and value == "true" then

            reason = trim(reason)

            if reason == "" then
                reason = "No reason provided."
            end

            newBlacklist[userId] = {
                reason = reason
            }

        else

            local plainUserId =
                line:match(
                    '"%s*(%d+)%s*"%s*:%s*true'
                )

            if plainUserId then

                newBlacklist[plainUserId] = {
                    reason = "No reason provided."
                }

            end

        end
    end

    blacklist = newBlacklist

    local count = 0

    for _ in pairs(newBlacklist) do
        count += 1
    end

    if count == 0 then

        sendWebhook(
            "⚠️ Blacklist Warning",
            "**The GitHub blacklist was downloaded, but no valid entries were found.**"
        )

        return false
    end

    sendWebhook(
        "🟢 Blacklist Updated",
        "**Entries loaded:** `"
        .. tostring(count)
        .. "`"
    )

    return true
end

--==================================================
-- BLACKLIST CHECK
--==================================================

local function isBlacklisted(player)

    if not player then
        return false, nil
    end

    local userId =
        tostring(player.UserId)

    local entry =
        blacklist[userId]

    if entry then
        return true, entry.reason
    end

    return false, nil
end

--==================================================
-- BLACKLIST ALERT
--==================================================

local function alertBlacklisted(player)

    local userId =
        tostring(player.UserId)

    if blacklistAlertedThisSession[userId] then
        return
    end

    local now =
        os.clock()

    local lastAlert =
        blacklistAlertCooldown[userId]

    if lastAlert
        and (now - lastAlert) < BLACKLIST_ALERT_COOLDOWN then

        blacklistAlertedThisSession[userId] = true

        return
    end

    local blacklisted, reason =
        isBlacklisted(player)

    if not blacklisted then
        return
    end

    blacklistAlertedThisSession[userId] = true
    blacklistAlertCooldown[userId] = now

    local username =
        escapeMarkdown(player.Name)

    local displayName =
        escapeMarkdown(player.DisplayName)

    sendChatMessage("test")

    sendWebhook(
        "test",

        "**Player:** `"
        .. username
        .. "`\n"

        .. "**Display Name:** `"
        .. displayName
        .. "`\n"

        .. "**User ID:** `"
        .. userId
        .. "`\n\n"

        .. "**Reason:**\n"
        .. reason
        .. "\n\n"

        .. "**Game:** `"
        .. escapeMarkdown(game.Name)
        .. "`\n"

        .. "**Place ID:** `"
        .. tostring(game.PlaceId)
        .. "`\n"

        .. "**Job ID:** `"
        .. escapeMarkdown(game.JobId)
        .. "`",

        true
    )
end

